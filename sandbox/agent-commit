#!/bin/bash
# Usage: agent-commit <AgentName> [git commit args...]
# Sets both author and committer to the agent, avoiding config pollution.

set -e

if [ -z "$1" ]; then
    echo "Usage: agent-commit <AgentName> [git commit args...]" >&2
    echo "Example: agent-commit Opus -m \"Fix the thing\"" >&2
    exit 1
fi

AGENT=$1
shift

case "$AGENT" in
    Opus)   EMAIL="opus@placeholder.dev" ;;
    Sonnet) EMAIL="sonnet@placeholder.dev" ;;
    Haiku)  EMAIL="haiku@placeholder.dev" ;;
    # Stateless Claude Code sessions; the model is recorded in the Co-Authored-By trailer
    ClaudeCode) AGENT="Claude Code"; EMAIL="claude-code@placeholder.dev" ;;
    # Open-weight model test instances
    model_test_agent) AGENT="model_test_agent"; EMAIL="model-test-agent@placeholder.dev" ;;
    *)
        echo "Unknown agent: $AGENT" >&2
        echo "Valid agents: Opus, Sonnet, Haiku, ClaudeCode, model_test_agent" >&2
        exit 1
        ;;
esac

GIT_AUTHOR_NAME="$AGENT" GIT_AUTHOR_EMAIL="$EMAIL" \
GIT_COMMITTER_NAME="$AGENT" GIT_COMMITTER_EMAIL="$EMAIL" \
    git commit "$@"
